# Copy to .env (in the folder you start the backend from) and adjust.
# Never put real secrets here: .env is gitignored, this file is the template.

# dev | prod. APP_ENV=prod requires STORE=firestore and AUTH_MODE=firebase.
# The API refuses to start when APP_ENV is not set here.
APP_ENV=dev

# id (Cendekiara, Indonesian + English) | global (English only).
SITE=id

# memory (in-process, local dev and tests) | firestore (production).
STORE=memory

# dev (token "dev:<uid>", local only) | firebase (Firebase ID tokens).
AUTH_MODE=dev

# inline (background thread, local) | cloudtasks (production).
JOBS=inline

# Comma-separated emails of the admins.
ADMIN_EMAILS=

# The URL of the site. CORS on /api allows this origin and CAPACITOR_ORIGIN.
SITE_URL=http://localhost:5173

# The origin of the Android app (Capacitor), e.g. capacitor://localhost or http://localhost.
CAPACITOR_ORIGIN=

# Admin API token for `cendekiara run --remote <url>`. Keep it secret.
#CENDEKIARA_TOKEN=

# Exam engine
SUBMIT_GRACE_SEC=60
ATTEMPT_SAVE_RATE_LIMIT=30
ATTEMPT_SAVE_MAX_BYTES=20000
STUDY_CHECK_RATE_LIMIT=60
STUDY_CHECK_MAX_BYTES=10000

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
